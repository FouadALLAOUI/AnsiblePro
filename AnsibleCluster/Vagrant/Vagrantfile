Vagrant.configure("2") do |config|
  
    # First VM - ansible-master
    config.vm.define "ansible-master" do |ansible|
      ansible.vm.box = "bento/ubuntu-22.04"
      ansible.vm.hostname = "ansible-master"
      
      ansible.vm.provider "vmware_desktop" do |v|
        v.memory = 2048
        v.cpus = 2
        v.gui = true
        v.vmx["virtualHW.version"] = "19"
      end

      # Provision script to install Ansible on the master VM
      ansible.vm.provision "shell", inline: <<-SHELL
        apt update
        apt install ansible -y
        # Create a directory for Ansible playbooks
        mkdir -p /home/vagrant/ansible-playbooks
        # Copy the Ansible playbook from the host to the VM
        #cp ../Playbooks/* /home/vagrant/ansible-playbooks/
      SHELL
    end

    # Second VM - agent-ubuntu-vm
    config.vm.define "agent-ubuntu-vm" do |agent|
      agent.vm.box = "bento/ubuntu-22.04"
      agent.vm.hostname = "agent-ubuntu-vm"
      
      agent.vm.provider "vmware_desktop" do |v| 
        v.memory = 2048
        v.cpus = 2
        v.gui = true
        v.vmx["virtualHW.version"] = "19"
      end
      
      # Provision script to update the package list on the agent VM
      agent.vm.provision "shell", inline: <<-SHELL
        apt update
      SHELL
    end

    # Third VM - agent-centos-vm
    config.vm.define "agent-centos-vm" do |agent|
      agent.vm.box = "bento/centos-7"
      agent.vm.hostname = "agent-centos-vm"
      
      agent.vm.provider "vmware_desktop" do |v| 
        v.memory = 2048
        v.cpus = 2
        v.gui = true
        v.vmx["virtualHW.version"] = "19"
      end
      
      # Provision script to update the package list on the agent VM
      agent.vm.provision "shell", inline: <<-SHELL
        yum update -y
      SHELL
    end

    # Fourth VM - agent-redhat-vm
    config.vm.define "agent-redhat-vm" do |agent|
      agent.vm.box = "generic/rocky9"
      agent.vm.hostname = "agent-redhat-vm"

      agent.vm.provider "vmware_desktop" do |v|
        v.memory = 2048
        v.cpus = 2
        v.gui = true
        v.vmx["virtualHW.version"] = "19"
      end

      # Provision script to update packages on the agent VM
      agent.vm.provision "shell", inline: <<-SHELL
        dnf update -y
      SHELL
    end


  end