Vagrant.configure("2") do |config|

  # First VM - rke2
  config.vm.define "rke2" do |rke2|
    rke2.vm.box = "bento/ubuntu-22.04"
    rke2.vm.hostname = "rke2"

    rke2.vm.provider "vmware_desktop" do |v|
      v.memory = 8192 # 12GB
      v.cpus = 4
      v.gui = true
      v.vmx["virtualHW.version"] = "19"
    end

    # Provision script to install RKE2 + kubectl and configure kubeconfig
    rke2.vm.provision "shell", inline: <<-SHELL
      set -e

      apt update -y
      apt install -y curl

      # --- Install RKE2 server ---
      curl -sfL https://get.rke2.io | sh -
      systemctl enable rke2-server.service
      systemctl start rke2-server.service

      # --- Wait for the kubeconfig to be generated ---
      until [ -f /etc/rancher/rke2/rke2.yaml ]; do
        echo "Waiting for rke2.yaml..."
        sleep 5
      done

      # --- Install kubectl (same version as the RKE2 Kubernetes) ---
      K8S_VERSION=$(/usr/local/bin/rke2 --version | head -n1 | awk '{print $3}' | cut -d+ -f1)
      curl -fsSLo /tmp/kubectl "https://dl.k8s.io/release/${K8S_VERSION}/bin/linux/amd64/kubectl"
      install -o root -g root -m 0755 /tmp/kubectl /usr/local/bin/kubectl
      rm -f /tmp/kubectl

      # --- Configure kubeconfig for vagrant and root ---
      for HOME_DIR in /home/vagrant /root; do
        mkdir -p ${HOME_DIR}/.kube
        cp /etc/rancher/rke2/rke2.yaml ${HOME_DIR}/.kube/config
        chmod 600 ${HOME_DIR}/.kube/config
      done
      chown -R vagrant:vagrant /home/vagrant/.kube

      # --- Convenience: alias + autocompletion for vagrant ---
      echo 'export KUBECONFIG=$HOME/.kube/config' >> /home/vagrant/.bashrc
      echo 'source <(kubectl completion bash)' >> /home/vagrant/.bashrc
      echo 'alias k=kubectl' >> /home/vagrant/.bashrc
      echo 'complete -o default -F __start_kubectl k' >> /home/vagrant/.bashrc

      # --- Quick check ---
      kubectl --kubeconfig /home/vagrant/.kube/config get nodes
    SHELL
  end
end