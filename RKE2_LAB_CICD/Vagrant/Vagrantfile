      # SHELL
    end

    # Sixth VM - Rancher-vm
    config.vm.define "rancher-vm" do |rancher|
      rancher.vm.box = "bento/ubuntu-22.04"
      rancher.vm.hostname = "rancher-vm"
      
      rancher.vm.provider "vmware_desktop" do |v|
        v.memory = 4096
