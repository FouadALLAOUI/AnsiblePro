Vagrant.configure("2") do |config|
  config.vm.define "devstack-vm" do |agent|
    agent.vm.box = "bento/ubuntu-22.04"
    agent.vm.hostname = "devstack-vm"

    # Private IP so you can reach Horizon from the host
    agent.vm.network "private_network", ip: "192.168.56.10"

    agent.vm.provider "vmware_desktop" do |v|
      v.memory = 8192          # 8192 minimum, 12-16 GB better
      v.cpus = 4
      v.gui = true
      v.vmx["virtualHW.version"] = "19"
      #v.vmx["vhv.enable"] = "TRUE"   # nested virtualization for Nova/KVM
    end

    agent.vm.provision "shell", inline: <<-SHELL
      apt-get update
      apt-get install -y git

      # Create the stack user (DevStack can't run as root)
      useradd -s /bin/bash -d /opt/stack -m stack || true
      chmod +x /opt/stack
      echo "stack ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/stack

      # Clone DevStack and write local.conf
      sudo -u stack bash -c '
        cd /opt/stack
        [ -d devstack ] || git clone https://opendev.org/openstack/devstack
        cat > devstack/local.conf <<EOF
[[local|localrc]]
FORCE=yes
ADMIN_PASSWORD=secret
DATABASE_PASSWORD=secret
RABBIT_PASSWORD=secret
SERVICE_PASSWORD=secret
HOST_IP=192.168.56.10
EOF
      '
    SHELL
  end
end